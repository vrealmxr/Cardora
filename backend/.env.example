APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_URL=http://localhost:5173
AUTH_EMAIL_VERIFICATION_URL="${FRONTEND_URL}/epivevaiosi-email"
AUTH_PASSWORD_RESET_URL="${FRONTEND_URL}/epanafora-kodikou"
AUTH_EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=GR
STRIPE_MARKETPLACE_COMMISSION_RATE=0.00
STRIPE_MARKETPLACE_BUYER_FEE_RATE=0.00
STRIPE_CONFIRMATION_WINDOW_DAYS=7
STRIPE_CHECKOUT_SUCCESS_URL="${FRONTEND_URL}/checkout/success"
STRIPE_CHECKOUT_CANCEL_URL="${FRONTEND_URL}/checkout"
STRIPE_CONNECT_RETURN_FRONTEND_URL="${FRONTEND_URL}/profil"
STRIPE_CONNECT_REFRESH_FRONTEND_URL="${FRONTEND_URL}/profil?stripe_connect=refresh"

# DHL Express MyDHL API (https://developer.dhl.com)
# Leave DHL_API_ENABLED=false until credentials are provisioned; shipments stay in a pending state meanwhile.
DHL_API_ENABLED=false
DHL_API_USE_TEST_ENVIRONMENT=true
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi
DHL_API_TEST_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_API_ACCOUNT_NUMBER=
DHL_API_DEFAULT_PRODUCT_CODE=N
DHL_API_DEFAULT_PACKAGE_WEIGHT_KG=0.5
DHL_AUTO_RELEASE_DAYS_AFTER_DELIVERY=2

# BoxNow shipping (on hold until BoxNow API credentials are provisioned)
BOXNOW_API_ENABLED=false
BOXNOW_API_USE_TEST_ENVIRONMENT=true
BOXNOW_API_BASE_URL=https://api-production.boxnow.gr
BOXNOW_API_TEST_BASE_URL=https://api-stage.boxnow.gr
BOXNOW_API_CLIENT_ID=
BOXNOW_API_CLIENT_SECRET=
BOXNOW_API_WAREHOUSE_ID=
BOXNOW_API_AUTH_PATH=/api/v1/auth-sessions
BOXNOW_API_SHIPMENTS_PATH=/api/v1/delivery-requests
BOXNOW_API_LOCKERS_PATH=/api/v1/destinations/points
BOXNOW_API_DEFAULT_PACKAGE_WEIGHT_KG=0.5
BOXNOW_AUTO_RELEASE_DAYS_AFTER_DELIVERY=2
